---
import { getEntry, getCollection, render } from 'astro:content';
import MarkdownPostLayout from '@/layouts/MarkdownPostLayout.astro';

export const prerender = true;

const collection = 'design';

export async function getStaticPaths() {
  const entries = await getCollection('design');

  return entries.map((entry) => ({
    params: {
      slug: entry.id, // Content Layer: id 取代旧 slug
    },
    props: {
      slug: entry.id,
    },
  }));
}

const { slug } = Astro.props;

const entry = await getEntry(collection, slug);
if (!entry) throw new Error(`未找到 ${collection}/${slug}`);

const toc = entry?.data.toc;

const { Content, headings } = await render(entry);
---
<MarkdownPostLayout entry={entry} collection={collection} toc={toc} headings={headings}>
  <Content />
</MarkdownPostLayout>
