---
export interface Props {
  page: number;
  totalPages: number;
  collection?: string;
  /** 覆盖默认的 /{collection} 前缀（如 /project/photography） */
  basePath?: string;
}
import { getPaginationRange } from "@/utils/getPaginationRange";

const { page, totalPages, collection = "blog", basePath } = Astro.props;
const prefix = basePath ?? `/${collection}`;
const pages = getPaginationRange(page, totalPages);
---

<nav class="pagination flex gap-2 mt-12 justify-start">
  {pages.map(p =>
    typeof p === "number" ? (
      <a
        class={`px-3 py-1 rounded-xl duration-300 ${p === page ? 'bg-black text-white' : ' hover:bg-white'}`}
        href={`${prefix}${p === 1 ? '' : `/page/${p}`}`}
      >
        {p}
      </a>
    ) : (
      <span class="px-2 text-gray-400">…</span>
    )
  )}
</nav>
